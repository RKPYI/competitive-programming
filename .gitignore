*.out
*.exe
*.o
*.obj
*.bin
*.a
*.so
*.dll
*.dylib
*.gch
*.pch
*.dSYM/

# Sample input/output files used for local testing
in*.txt
out*.txt
input*.txt
output*.txt
*.in
*.ans

# Editor & OS clutter
.vscode/
.idea/
*.swp
*~
